PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/mugan-style

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# YooKassa — placeholders until real test credentials are provided
YOOKASSA_SHOP_ID=000000
YOOKASSA_SECRET_KEY=test_placeholder
YOOKASSA_RETURN_URL=http://localhost:5173/order/:orderNumber/result

ADMIN_SEED_EMAIL=admin@muganstyle.ru
ADMIN_SEED_PASSWORD=change-me-please

# Cloudinary — optional. Leave blank to use local disk storage (fine for
# dev; lost on redeploy on most hosts). Fill in to persist uploaded product
# photos permanently — get these from cloudinary.com → Dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
